# OpenSearch Dashboards with the Maps plugin's opening view changed.
#
# Why this exists: the Maps plugin in 2.18 builds its map from a hardcoded
# constant and never reads zoom or centre back out of the saved object, so a
# map always opens on the whole world no matter what you save. There is no
# setting for it. This patches the constant in the built browser bundle.
#
# Defaults are south-east Australia, matching the Logstash pipeline's area of
# interest and the tile grid. Override at build time:
#
#   docker compose build --build-arg MAP_ZOOM=4 opensearch-dashboards
#   docker compose up -d opensearch-dashboards
#
FROM opensearchproject/opensearch-dashboards:2.18.0

ARG MAP_LNG=147.5
ARG MAP_LAT=-34.0
ARG MAP_ZOOM=3

USER root

# 1. Patch the opening view into the browser bundle.
RUN set -eux; \
    d=/usr/share/opensearch-dashboards/plugins/customImportMapDashboards/target/public; \
    f="$d/customImportMapDashboards.plugin.js"; \
    old='MAP_INITIAL_STATE={lng:0,lat:0,zoom:1}'; \
    new="MAP_INITIAL_STATE={lng:${MAP_LNG},lat:${MAP_LAT},zoom:${MAP_ZOOM}}"; \
    # Fail the build rather than silently do nothing if the upstream bundle
    # changes shape, which it will on a version bump.
    grep -q "$old" "$f"; \
    sed -i "s/$old/$new/" "$f"; \
    grep -q "$new" "$f"; \
    # The plugin ships precompressed bundles and Dashboards serves those in
    # preference to the plain .js. Without removing them the patch has no
    # effect at all, because the browser never sees the file we edited.
    rm -f "$f.br" "$f.gz"; \
    echo "patched opening view -> lng=${MAP_LNG} lat=${MAP_LAT} zoom=${MAP_ZOOM}"

# 2. Bust the browser cache.
#
# Bundles are served from /<buildNumber>/bundles/... with
# cache-control: max-age=31536000, a year. Patching a bundle does not change
# its URL, so a browser that has already loaded the page keeps the old copy
# and your change appears to do nothing at all.
#
# Deriving the build number from the patched values gives every distinct
# opening view its own URL, so a rebuild busts the cache by itself. Identical
# builds keep the same number, so nothing churns needlessly.
RUN set -eux; \
    p=/usr/share/opensearch-dashboards/package.json; \
    bn=$(printf '%s:%s:%s' "${MAP_LNG}" "${MAP_LAT}" "${MAP_ZOOM}" | cksum | cut -d' ' -f1); \
    grep -qE '"number": *[0-9]+' "$p"; \
    sed -i -E "s/\"number\": *[0-9]+/\"number\": ${bn}/" "$p"; \
    grep -q "\"number\": ${bn}" "$p"; \
    echo "build number -> ${bn} (bundle URLs become /${bn}/bundles/...)"

USER 1000
